# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/stas_request_pembelian?schema=public"

# JWT & HttpOnly Cookie Configuration
# Gunakan minimal 32 karakter acak untuk lingkungan produksi
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-untuk-produksi"
JWT_EXPIRES_IN_SECONDS=28800
AUTH_COOKIE_NAME=stas_access_token
COOKIE_SECURE=false

# Seed Akun Admin Awal (opsional, dipakai oleh pnpm --filter @stas/api prisma:seed)
ADMIN_SEED_EMAIL=admin@gmail.com
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_IDENTIFIER=admin
